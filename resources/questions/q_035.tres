[resource]
script = ExtResource("1_2xrxu")
npc_name = "Influencer"
question_text = "Pajak konten digital katanya mau naik, ini serius?"
likes = Array[String](["Dialog"])
dislikes = Array[String](["Pajak"])
reaction_like = "Untung deh pajaknya gak jadi naik, Pak."
