[resource]
script = ExtResource("1_nyejp")
npc_name = "Lansia"
question_text = "Bantuan bulan ini belum cair, saya cuma makan seadanya."
likes = Array[String](["Bansos", "Maaf"])
dislikes = Array[String](["Tunda"])
reaction_like = "Untung juga bantuan saya udah cair, Pak."
reaction_dislike = "Bantuan tetep belum cair, Pak, saya makan seadanya."
reaction_neutral = "Itu jawabannya soal apa ya, Pak? Saya nanya bantuan saya."
reaction_belittled = "Saya udah tua, Pak, tolong jangan dianggap gak penting."
