[resource]
script = ExtResource("1_cu2y0")
npc_name = "Mahasiswa Rantau"
question_text = "Uang kuliah naik tiap tahun, orang tua saya pusing mikirinnya."
likes = Array[String](["Subsidi", "Dialog"])
dislikes = Array[String](["Tunda"])
reaction_like = "Wah, akhirnya biaya kuliah jadi ringan, Pak!"
reaction_dislike = "UKT tetep mahal aja, Pak, kasihan ortu saya."
reaction_neutral = "Pak, saya nanya UKT kok jawabnya ngalor-ngidul gitu?"
reaction_belittled = "Pendidikan itu hak, Pak, jangan dianggap gak penting."
