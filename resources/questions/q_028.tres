[resource]
script = ExtResource("1_7v7ih")
npc_name = "Menteri Keuangan"
question_text = "Investor kami butuh kepastian regulasi, bukan kejutan kebijakan."
likes = Array[String](["Investasi", "Deregulasi"])
dislikes = Array[String](["Nasionalisasi"])
reaction_like = "Kepastian regulasi ini yang investor butuhkan, Pak."
reaction_dislike = "Kejutan kebijakan bikin investor kabur, Pak."
