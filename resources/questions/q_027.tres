[resource]
script = ExtResource("1_ybkie")
npc_name = "Warga Konflik Daerah"
question_text = "Kapan kami bisa hidup tenang tanpa takut baku tembak?"
likes = Array[String](["Dialog"])
dislikes = Array[String](["Represif"])
reaction_like = "Akhirnya daerah kami mulai tenang, Pak."
reaction_dislike = "Baku tembak masih aja terjadi, Pak."
reaction_neutral = "Pak, saya tanya soal keamanan kok jawabnya ke arah lain?"
reaction_belittled = "Kami cuma mau hidup tenang, Pak, jangan dianggap remeh."
