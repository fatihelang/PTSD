[resource]
script = ExtResource("1_tswy4")
npc_name = "Mantan TKI"
question_text = "Kami dulu disiksa majikan, negara ke mana waktu itu?
"
likes = Array[String](["Dialog", "Transparansi"])
dislikes = Array[String](["Tunda"])
reaction_like = "Terima kasih Pak, akhirnya negara peduli sama kami."
reaction_dislike = "Kok masih kayak gak dianggap gini, Pak."
reaction_neutral = "Itu jawabannya nyambung ke nasib kami di luar negeri nggak, Pak?"
reaction_belittled = "Kami udah cukup disiksa di luar negeri, jangan diinjek lagi di sini, Pak."
