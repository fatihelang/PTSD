[resource]
script = ExtResource("1_61em7")
npc_name = "Perwira Aktif"
question_text = "Senjata kita ketinggalan, tetangga makin canggih."
likes = Array[String](["Investasi"])
dislikes = Array[String](["Evaluasi"])
reaction_like = "Alutsista kita jadi makin siap, mantap Pak!"
reaction_dislike = "Alutsista kita tetep ketinggalan, Pak."
reaction_neutral = "Pak, itu ada hubungannya sama alutsista kami nggak?"
reaction_belittled = "Pertahanan negara ini serius, Pak, jangan dianggap remeh."
