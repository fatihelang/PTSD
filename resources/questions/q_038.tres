[resource]
script = ExtResource("1_7r4q6")
npc_name = "Warga Overtourism"
question_text = "Air kami habis buat vila turis, warga lokal kebagian apa?"
likes = Array[String](["Evaluasi", "Transparansi"])
dislikes = Array[String](["Investasi"])
reaction_like = "Akhirnya air kami cukup lagi, Pak."
reaction_dislike = "Air kami tetep habis buat vila turis, Pak."
reaction_neutral = "Itu jawabannya nyambung ke air kami nggak, Pak?"
reaction_belittled = "Kami warga lokal juga butuh air, Pak, jangan dilupain."
