[resource]
script = ExtResource("1_aj3a0")
npc_name = "Pengusaha Ekspor Sawit"
question_text = "Uni Eropa mempersulit ekspor sawit kita terus."
likes = Array[String](["Ekspor", "Dialog"])
dislikes = Array[String](["Represif"])
reaction_like = "Ekspor sawit kita makin lancar, terima kasih Pak."
reaction_dislike = "Uni Eropa makin ketat aja, Pak, kita rugi."
reaction_neutral = "Pak, itu jawabannya nyambung ke Uni Eropa nggak sih?"
reaction_belittled = "Sawit ini andalan ekspor kita, Pak, jangan dipandang enteng."
