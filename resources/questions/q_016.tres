[resource]
script = ExtResource("1_78jub")
npc_name = "Aktivis Lingkungan"
question_text = "Hutan digunduli demi sawit, bumi makin panas."
likes = Array[String](["Transparansi", "Represif"])
dislikes = Array[String](["Deregulasi"])
reaction_like = "Bagus, hutan kita mulai diselamatkan, Pak!"
reaction_dislike = "Hutan tetep aja digunduli, Pak, bumi makin panas."
reaction_neutral = "Kok gak nyambung ke hutan ya, Pak? Bumi kami tetep panas."
reaction_belittled = "Lingkungan ini rumah semua orang, Pak, jangan dianggap sepele."
