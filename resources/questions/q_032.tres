[resource]
script = ExtResource("1_rxe12")
npc_name = "Buruh Perkebunan Sawit"
question_text = "Upah kami di bawah standar, padahal sawit ini bikin negara kaya."
likes = Array[String](["Bansos", "Pajak"])
dislikes = Array[String](["Deregulasi"])
reaction_like = "Akhirnya upah kami mulai layak, Pak."
reaction_dislike = "Upah tetep di bawah standar, Pak."
reaction_neutral = "Itu ada hubungannya sama upah kami nggak, Pak?"
reaction_belittled = "Sawit ini bikin negara kaya, Pak, jangan remehkan kami."
