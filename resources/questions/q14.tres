script = ExtResource("1_ughws")
npc_name = "Perawat Rumah Sakit"
question_text = "Kami lembur terus tapi insentif malah dipotong."
likes = Array[String](["Bansos", "Maaf"])
dislikes = Array[String](["Tunda"])
reaction_like = "Puji tuhan insentif kami balik normal, Pak."
reaction_dislike = "Insentif tetep dipotong, Pak, kami capek."
reaction_neutral = "Lah... itu jawabannya soal apa, Pak? Saya nanya insentif kami."
reaction_belittled = "Kami lembur demi pasien, Pak, jangan diremehin gitu."
