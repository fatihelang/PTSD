script = ExtResource("1_43iry")
npc_name = "Pedagang Pasar"
question_text = "Barang impor lebih murah, lapak kami sepi pembeli."
likes = Array[String](["Subsidi"])
dislikes = Array[String](["Impor"])
reaction_like = "Lapak kami mulai rame lagi, makasih Pak."
reaction_dislike = "Barang impor tetep aja nyerbu, Pak."
reaction_neutral = "Kok gak nyambung ya, Pak? Saya tanya soal lapak saya."
reaction_belittled = "Dagang kecil ini nyawa keluarga saya, Pak, jangan disepelein."
