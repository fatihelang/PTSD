[resource]
script = ExtResource("1_4vto6")
npc_name = "Pemilik UMKM Kuliner"
question_text = "Izin usaha ribet banget, kapan dipermudah?"
likes = Array[String](["Subsidi", "Deregulasi"])
dislikes = Array[String](["Pajak"])
reaction_like = "Wah, izinnya jadi cepat, mantap Pak!"
reaction_dislike = "Ribetnya tetep aja sama, Pak."
reaction_neutral = "Pak... itu jawabannya ada hubungannya sama izin usaha saya?"
reaction_belittled = "Usaha kecil kami juga berjuang, Pak, jangan dianggap remeh."
