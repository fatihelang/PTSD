[ext_resource type="Script" uid="uid://bbna8cds2e0bn" path="res://scripts/question_data.gd" id="1_tnvjs"]

[resource]
script = ExtResource("1_tnvjs")
npc_name = "Diplomat Kedutaan AS"
question_text = "Mitra dagang kami butuh sinyal jelas soal iklim investasi."
likes = Array[String](["Investasi", "Dialog"])
dislikes = Array[String](["Nasionalisasi"])
reaction_like = "Sinyal investasi ini positif bagi hubungan kita, Pak."
reaction_dislike = "Ini bikin mitra dagang kami ragu, Pak."
reaction_neutral = "Dengan hormat, jawaban ini kurang relevan dengan pertanyaan kami, Pak."
reaction_belittled = "Hubungan bilateral ini serius, Pak, tolong jangan diremehkan."
