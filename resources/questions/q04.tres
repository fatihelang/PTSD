reaction_like = "Alhamdulillah upah kami mendingan sekarang, Pak."
reaction_dislike = "Yah, gaji tetep gitu-gitu aja, Pak."
reaction_neutral = "Lah kok jawabannya beda topik, Pak? Saya nanya soal upah."
reaction_belittled = "Kami kerja keras tiap hari, jangan diremehin gitu, Pak."
