[resource]
script = ExtResource("1_bpahg")
npc_name = "Dosen"
question_text = "Dana riset kami kalah jauh sama negara tetangga."
likes = Array[String](["Investasi", "Transparansi"])
dislikes = Array[String](["Tunda"])
reaction_like = "Dana riset kami jadi lega, makasih Pak."
reaction_dislike = "Riset kita tetep kalah sama negara tetangga, Pak."
reaction_neutral = "Kok jawabannya melenceng, Pak? Saya nanya dana riset."
reaction_belittled = "Riset itu investasi masa depan, Pak, jangan dianggap remeh."
