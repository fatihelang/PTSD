[resource]
script = ExtResource("1_c68av")
npc_name = "Buruh Migran"
question_text = "Perlindungan buat kami di luar negeri masih lemah banget."
likes = Array[String](["Dialog", "Transparansi"])
dislikes = Array[String](["Represif"])
reaction_like = "Untung juga perlindungan kami membaik, Pak."
